// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "status_bar": {
    "show_active_file": false
  },
  "cli_default_open_behavior": "new_window",
  "edit_predictions": {
    "disabled_globs": [
        "**/*.toml",
        "**/*.yml",
        "**/*.yaml",
        "**/*.json",
        "**/*.jsonc",
        "**/*.env",
        "**/*.ini",
        "**/*.conf",
        "**/*.config",
        "**/*.properties",
        "**/.editorconfig",
        "**/.gitconfig",
        "**/.npmrc",
        "**/.yarnrc",
        "**/.prettierrc",
        "**/.eslintrc",
        "**/.stylelintrc",
      ],
    "open_ai_compatible_api": {
      "prompt_format": "qwen",
      "api_url": "http://localhost:8000/v1/completions",
      "model": "Qwen2.5-Coder-7B-4bit",
      "max_output_tokens": 256,
    },
    "ollama": {
      "api_url": "http://localhost:11434",
      "model": "qwen2.5-coder:7b-base",
      "prompt_format": "infer",
      "max_output_tokens": 256,
    },
    "mode": "subtle",
    "provider": "open_ai_compatible_api",
  },
  "language_models": {
    "openai_compatible": {
      "oMLX": {
        "api_url": "http://localhost:8000/v1",
        "available_models": [
          {
            "name": "Qwen2.5-Coder-7B-4bit",
            "max_tokens": 32768,
          },
          {
            "name": "Qwen3.6-27B-mxfp4",
            "max_tokens": 32768,
          },
        ],
      },
    },
  },
  "proxy": "",
  "base_keymap": "VSCode",
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "agent": "default",
        "fast": false
      },
      "type": "registry"
    },
    "codex-acp": {
      "favorite_config_option_values": {
        "mode": ["full-access"],
      },
      "type": "registry",
    },
  },
  "agent": {
    "tool_permissions": {
      "default": "allow",
      "tools": {},
    },
    "default_profile": "write",
    "default_model": {
      "effort": "medium",
      "provider": "openai-subscribed",
      "model": "gpt-5.5",
      "enable_thinking": true,
    },
    "favorite_models": [
      {
        "provider": "oMLX",
        "model": "Qwen2.5-Coder-7B-Instruct-MLX-4bit",
        "enable_thinking": false,
      },
    ],
    "model_parameters": [],
  },
  "lsp": {
    "buf": {
      "initialization_options": {
        "command": ["buf", "lsp", "serve", "--log-format", "json"],
      },
    },
  },
  // fonts
  "buffer_font_family": "JetBrains Mono",
  "buffer_font_size": 12,
  "ui_font_size": 14,
  "agent_ui_font_size": 14,
  "theme": {
    "mode": "system",
    "light": "Zedokai Light",
    "dark": "Zedokai (Filter Spectrum)",
  },
  // vim mode
  "relative_line_numbers": "enabled",
  "vim_mode": true,
  // zed
  "telemetry": {
    "metrics": false,
  },
}
